# ── Mortgage Work auth service — server-side config template ──
# Copy to server/.env and fill in. Loaded by server/main.py only; the
# desktop app's root .env only carries the client-side AUTH_SERVICE_URL.

# Bind address: 127.0.0.1 for local-only, 0.0.0.0 when the app on other
# machines must reach this service.
AUTH_HOST=127.0.0.1
AUTH_PORT=9898

# HMAC key for session tokens. Leave unset to auto-generate (persisted in
# server/data/.secret); set explicitly when running multiple replicas.
#AUTH_SECRET=

# Interactive API docs: when set, /docs and /openapi.json need ?token=<value>.
# Leave unset for local dev (docs stay open).
#DOCS_TOKEN=

# Credential for the /admin/* surface (users, plans, redemption codes), sent
# as the X-Admin-Token header. The browser/ admin viewer must carry the SAME
# value. Empty means "local dev, skip the check" — set a strong random value
# (32+ alphanumeric) in production.
ADMIN_TOKEN=<admin-token>

# Login-code mail delivery: console | smtp | resend
EMAIL_PROVIDER=console

# smtp provider (Gmail: password = 16-char app password, NOT the login):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=<gmail-app-password>
#SMTP_FROM=you@gmail.com        # defaults to SMTP_USER; Gmail demands they match

# resend provider (needs a verified sender domain):
#RESEND_API_KEY=
#RESEND_FROM=Mortgage Work <noreply@yourdomain.com>

# Repo provisioning host override (blank = region decides: cn→codeup,
# intl→github). Set `local` for single-box dev (bare repos in server/data).
#PROVISIONER=local
#GITHUB_TOKEN=<pat with repo scope>
#GITHUB_ORG=

# Codeup (cn region): personal access token with repo + file read/write
# scopes (云效 → 个人设置 → 个人访问令牌), and the organization id — the
# 24-hex string in your codeup.aliyun.com URLs.
#CODEUP_TOKEN=<pt-...>
#CODEUP_ORG_ID=
#CODEUP_DOMAIN=codeup.aliyun.com

# Server state dir (SQLite, secret, local repos). Defaults to server/data.
#AUTH_DATA_DIR=

# ── Client service entitlement (delivered with every login session) ──
# The desktop release ships no infra secrets — these values are embedded in
# the session payload (see _services_block in main.py). Leave unset and the
# client degrades that feature. Empty strings are fine; they mean "skip".

# RAG service (vector dataset/ingest/query) and KG service (knowledge graph):
#RAG_SERVICE_URL=http://<host>:8000
#RAG_API_KEY=<rag-api-key>
#KG_SERVICE_URL=http://<host>:8001
#KG_API_KEY=<kg-api-key>

# Raw knowledge stores — the in-app Knowledge Base browser reads the user's
# own collection/graph directly (read-only, scoped to user_id by the client):
#QDRANT_URL=http://<host>:6333
#QDRANT_API_KEY=
#FALKORDB_URI=falkordb://[:password@]<host>:6379

# Web fetching keys for the QA agent (Firecrawl → Jina → local fallback):
#FIRECRAWL_API_KEY=<firecrawl-api-key>
#JINA_API_KEY=<jina-api-key>
