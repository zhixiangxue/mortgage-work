# ═══════════════════════════════════════════════════════════════════════════════
# Mortgage Work — service configuration (TEMPLATE)
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to `.env` and fill in real values. config.py reads `.env`; this template
# is the only one tracked in git. Never commit the real `.env`.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Data stores (where the browser viewers connect) ──────────────────────────
# The whole stack is deployed on one host by rag-service/scripts/infra.sh and
# shares one password. Port split is counter-intuitive: FalkorDB owns 6379,
# plain Redis sits on 6380.

# rqlite — basic auth, username fixed to "rag" by infra.sh
RQLITE_URI=http://rag:<password>@<host>:4001

# FalkorDB — Redis protocol + graph module
FALKORDB_URI=falkordb://:<password>@<host>:6379

# Qdrant — REST API port (gRPC 16334 is not used here)
QDRANT_URL=http://<host>:16333
QDRANT_API_KEY=<password>

# Redis — assembled into a redis:// URL by config.py
REDIS_HOST=<host>
REDIS_PORT=6380
REDIS_PASSWORD=<password>

# Meilisearch — no viewer yet; documented with the rest of the stack
MEILISEARCH_URL=http://<host>:7700
MEILISEARCH_API_KEY=<password>

# ── RAG service (vector dataset/ingest/query on :8000) ──────────────────────
# Wraps Qdrant; the app creates per-user datasets and ingests docs through this
# endpoint. Key is separate from the shared infra password.
RAG_SERVICE_URL=http://<host>:8000
RAG_API_KEY=<rag-api-key>

# ── KG service (knowledge graph on :8001) ───────────────────────────────────
# Wraps FalkorDB; graph creation/query goes through here. Same host, next port.
KG_SERVICE_URL=http://<host>:8001
KG_API_KEY=<kg-api-key>

# ── Remote worker supervision (supervisord XML-RPC) ──────────────────────────

# Enable [inet_http_server] in supervisord.conf on the remote host.
# Prefer SSH tunnel (ssh -L 9001:localhost:9001 ...) over exposing the port.
SUPERVISOR_URL=http://localhost:9001/RPC2

# ── Local viewer ports (the FastAPI browsers spawned by app.py) ──────────────

FALKORDB_VIEWER_PORT=8787
RQLITE_VIEWER_PORT=9090
QDRANT_VIEWER_PORT=8789
REDIS_VIEWER_PORT=8790

# ── Local agent service (chat over WebSocket, spawned by app.py) ──────────────

AGENT_PORT=8791

# ── LLM keys (used by rqlite viewer NL→SQL) ─────────────────────────────────

DEEPSEEK_API_KEY=
RQLITE_MODEL=deepseek/deepseek-v4-pro

# ── Web access keys (QA agent's web page reading) ───────────────────────────
# chak Web tool fetch chain: Firecrawl (Layer 1, best markdown) → Jina Reader
# (Layer 2) → local httpx+readability fallback (no key). Both keys optional;
# empty = that layer is skipped.

FIRECRAWL_API_KEY=<firecrawl-api-key>
JINA_API_KEY=<jina-api-key>

# ── Auth service (login + per-user repo provisioning, see server/) ──
# Client-side only: where this desktop app reaches the login service.
# The server's own config (mail provider, port, provisioning keys) lives
# in server/.env — see server/.env.example.
AUTH_SERVICE_URL=http://127.0.0.1:9898
