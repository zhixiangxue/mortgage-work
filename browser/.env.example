# ═══════════════════════════════════════════════════════════════════════════════
# Mortgage Browser — viewer configuration (TEMPLATE)
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to browser/.env and fill in real values. browser/config.py reads it;
# this template is the only one tracked in git. Never commit the real .env.
#
# The desktop app never reads this file — the viewers are a standalone unit.
# The whole stack is deployed on one host by rag-service/scripts/infra.sh and
# shares one password. Port split is counter-intuitive: FalkorDB owns 6379,
# plain Redis sits on 6380.

# portal entry page — lists every viewer with live status, one click to open.
# Always started by serve.sh, sits just below the viewer port block.
PORTAL_PORT=19786

# falkordb viewer — graph store (Redis protocol + graph module)
FALKORDB_URI=falkordb://:<password>@<host>:6379
FALKORDB_VIEWER_PORT=19787

# rqlite viewer — basic auth, username fixed to "rag" by infra.sh
RQLITE_URI=http://rag:<password>@<host>:4001
RQLITE_VIEWER_PORT=19788

# qdrant viewer — REST API port; the OPENAI key powers its semantic search
QDRANT_URL=http://<host>:16333
QDRANT_API_KEY=<password>
QDRANT_VIEWER_PORT=19789
OPENAI_API_KEY=<openai-api-key>

# redis viewer — HOST/PORT/PASSWORD are assembled into a redis:// URL by config.py
REDIS_HOST=<host>
REDIS_PORT=6380
REDIS_PASSWORD=<password>
REDIS_VIEWER_PORT=19790

# admin viewer — users, plans & redemption codes on the auth service.
# Local proxy mode: the page only talks to this viewer, which forwards with
# ADMIN_TOKEN attached — the token never enters a browser, and the server's
# CORS list stays untouched. Leave AUTH_SERVICE_URL unset and serve.sh skips
# this viewer. ADMIN_TOKEN must match the auth service's ADMIN_TOKEN env.
AUTH_SERVICE_URL=http://<host>:9898
ADMIN_TOKEN=<admin-token>
ADMIN_VIEWER_PORT=19791

# Optional LLM for the rqlite viewer's NL -> SQL feature. chak URI form:
# "provider@base_url:model" — "~" means the provider's default endpoint.
# Leave unset and the translate feature stays disabled; browsing still works.
#LLM_URI=openai@~:<model>
#LLM_API_KEY=<llm-api-key>
